{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build SFML Project",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-g",
                "*.cpp",
                "-o",
                "main",
                "-fPIC",
                "-I/opt/homebrew/Cellar/sfml/3.0.2/include",
                "-L/opt/homebrew/Cellar/sfml/3.0.2/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-lsfml-audio",
                "-framework",
                "CoreFoundation",
                "-framework",
                "AppKit",
                "-framework",
                "IOKit",
                "-framework",
                "OpenGL"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}